<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://media.rss.com/style.xsl"?>
<rss xmlns:podcast="https://podcastindex.org/namespace/1.0"
    xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
    xmlns:content="http://purl.org/rss/1.0/modules/content/"
    xmlns:psc="http://podlove.org/simple-chapters"
    xmlns:atom="http://www.w3.org/2005/Atom"
    xml:lang="en" version="2.0">
    <channel>
        <title>{{PODCAST_TITLE}}</title>
        <link>{{PODCAST_LINK}}</link>
        <atom:link href="{{PODCAST_FEED_URL}}" rel="self"
            type="application/rss+xml" />
        <atom:link rel="hub" href="https://pubsubhubbub.appspot.com/" />
        <description>{{PODCAST_DESCRIPTION}}</description>
        <generator>{{FEED_GENERATOR_TEXT}}</generator>
        <lastBuildDate>{{FEED_LAST_GENERATED_DATE}}</lastBuildDate>
        <language>{{PODCAST_LANGUAGE}}</language>
        <itunes:image href="https://assets.rss.com/images/no-cover-1400.jpg" />
        <podcast:guid>{{GUID}}</podcast:guid>
        <image>
            <url>{{PODCAST_PROFILE_IMAGE}}</url>
            <title>{{PODCAST_NAME}}</title>
            <link>https://rss.com/podcasts/smoking-goats</link>
        </image>
        <podcast:locked>yes</podcast:locked>
        <itunes:author>Uma Cabra</itunes:author>
        <itunes:owner>
            <itunes:name>Uma Cabra</itunes:name>
        </itunes:owner>
        <itunes:explicit>false</itunes:explicit>
        <itunes:type>episodic</itunes:type>
        <itunes:category text="Technology" />
        <podcast:medium>podcast</podcast:medium>
    </channel>
</rss>